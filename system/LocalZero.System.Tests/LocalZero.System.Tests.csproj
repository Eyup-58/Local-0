<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LocalZero.System.Tests</RootNamespace>
    <AssemblyName>LocalZero.System.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- Validates serialized messages against contracts/ipc.schema.json inside dotnet test, so the
         contract is machine-checked on every run rather than by a separate manual step. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schemas are the single source of truth and are read at test time from the repository,
         not copied, so a test can never pass against a stale duplicate. -->
    <None Include="..\..\contracts\*.schema.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalZero.System\LocalZero.System.csproj" />
  </ItemGroup>

</Project>
